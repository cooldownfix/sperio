                        <rect x="13" y="9" width="1" height="2" fill="#F4D35E"/>
                        <rect x="5" y="11" width="2" height="3" fill="#2D2418"/>
                        <rect x="9" y="11" width="2" height="3" fill="#2D2418"/>
                    </svg>
                </div>
                <div class="dev-pixel-circle">
                    <span class="dev-pixel-tooltip">Aizy</span>
                    <svg class="dev-pixel-art" viewBox="0 0 16 16" aria-hidden="true">
                        <rect x="5" y="2" width="6" height="2" fill="#5DADE2"/>
                        <rect x="6" y="4" width="4" height="2" fill="#F4C896"/>
                        <rect x="6" y="5" width="1" height="1" fill="#2D2418"/>
                        <rect x="9" y="5" width="1" height="1" fill="#2D2418"/>
