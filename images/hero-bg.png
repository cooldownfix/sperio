                    <svg class="dev-pixel-art" viewBox="0 0 16 16" aria-hidden="true">
                        <rect x="5" y="2" width="6" height="2" fill="#1C2833"/>
                        <rect x="5" y="3" width="2" height="1" fill="#2D2418"/>
                        <rect x="9" y="3" width="2" height="1" fill="#2D2418"/>
