<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="referrer" content="strict-origin-when-cross-origin">
    <meta name="description" content="ScanFall - A cozy 2D adventure platformer. Explore mysterious forests, silent caves, and ancient ruins in this charming indie game. Currently in Beta.">
    <meta name="theme-color" content="#7A9A52">
    <meta property="og:title" content="ScanFall  - A Small Adventure">
    <meta property="og:description" content="ScanFall  - A cozy 2D adventure platformer. Explore mysterious forests, silent caves, and ancient ruins in this charming indie game. Currently in Beta.">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://haisekingdom.pages.dev/">
    <meta property="og:image" content="https://haisekingdom.pages.dev/images/og-image.png">
    <meta property="og:image:type" content="image/png">
    <meta name="twitter:card" content="summary">
    <meta name="twitter:image" content="https://haisekingdom.pages.dev/images/og-image.png">
    <title>ScanFall  - A Small Adventure</title>

    <link rel="icon" type="image/png" href="images/favicon.png">
    <link rel="apple-touch-icon" href="images/favicon.png">

    <!-- Pixel Font: Press Start 2P -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Quicksand:wght@400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="style.css">
</head>
<body>

    <!-- ============================================ -->
    <!--                 NAVIGATION                   -->
    <!-- ============================================ -->
    <nav id="navbar">
        <div class="nav-inner">
            <!-- Easter egg: click logo 5 times -->
            <a href="#" class="nav-logo" id="nav-logo-link">ScanFall </a>
            <ul class="nav-links">
                <li><a href="#" class="nav-play-btn" id="nav-download-btn"><span class="nav-play-icon">▶</span> Play Now</a></li>
                <li><a href="#about">About</a></li>
                <li><a href="#characters">Characters</a></li>
                <li><a href="#screenshots">Screenshots</a></li>
                <li><a href="#features">Features</a></li>
                <li><a href="#roadmap">Roadmap</a></li>
                <li><a href="#achievements">Achievements</a></li>
                <li><a href="#faq">FAQ</a></li>
            </ul>
            <button class="nav-toggle" id="nav-toggle" aria-label="Toggle menu">☰</button>
        </div>
    </nav>

    <!-- ============================================ -->
    <!--                HERO SECTION                  -->
    <!-- ============================================ -->
    <!-- 
        HERO BACKGROUND IMAGE:
        Replace the background-image in style.css .hero section
        with your own artwork. The image should be large and cinematic.
        It will ONLY appear in this hero section.
    -->
    <section class="hero" id="hero">
        <div class="hero-overlay"></div>
        <div class="hero-content">
            <!-- Top row: game info (left) + gameplay preview (right) -->
            <div class="hero-top">
                <div class="hero-left">
                    <h1 class="hero-title" id="hero-title">ScanFall </h1>
                    <p class="hero-description">
                        Something stirs beneath the forgotten woods, whispering of paths no one remembers.
                        Step into a world where every shadow holds a story and every silence hides a secret.
                    </p>
                    <div class="hero-genre">2D Adventure Platformer</div>
                    <div class="hero-actions">
                        <!-- Download is gated by the beta access popup — see script.js for the download URL -->
                        <a href="#" class="btn-play" id="download-btn">
                            <span class="btn-play-icon">▶</span> PLAY NOW
                        </a>
                        <span class="beta-badge">BETA VERSION</span>
                    </div>
                    <div class="hero-trust">
                        <span class="trust-icon">🪟</span> Windows Beta Build &middot; Safe to Download
                    </div>
                    <div class="download-counter">
                        <span class="counter-icon">⬇</span> Downloads: <strong>47</strong>
                    </div>
                </div>
                <div class="hero-right">
                    <div class="gameplay-gif-container">
                        <div class="gif-frame">
                            <video
                                class="gameplay-gif"
                                src="videos/gameplay-preview.webm"
                                muted
                                loop
                                playsinline
                                preload="auto"
                                disablepictureinpicture
                                disableremoteplayback>
                            </video>
                        </div>
                        <p class="gif-caption">Gameplay preview - Beta footage</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Developer pixel avatars — sits in existing green space, no extra height -->
        <div class="hero-dev-row">
                <div class="dev-pixel-circle">
                    <span class="dev-pixel-tooltip">Emir</span>
                    <svg class="dev-pixel-art" viewBox="0 0 16 16" aria-hidden="true">
                        <rect x="5" y="2" width="6" height="2" fill="#2D2418"/>
                        <rect x="6" y="3" width="4" height="2" fill="#F4C896"/>
                        <rect x="6" y="4" width="1" height="1" fill="#2D2418"/>
                        <rect x="9" y="4" width="1" height="1" fill="#2D2418"/>
                        <rect x="4" y="5" width="8" height="6" fill="#7A9A52"/>
                        <rect x="5" y="6" width="6" height="1" fill="#5E7840"/>
                        <rect x="3" y="11" width="10" height="3" fill="#242924"/>
                        <rect x="4" y="11" width="8" height="2" fill="#5865F2"/>
                        <rect x="7" y="12" width="2" height="1" fill="#F4D35E"/>
                    </svg>
                </div>
                <div class="dev-pixel-circle">
                    <span class="dev-pixel-tooltip">Morin</span>
                    <svg class="dev-pixel-art" viewBox="0 0 16 16" aria-hidden="true">
                        <rect x="5" y="2" width="6" height="1" fill="#8B4513"/>
                        <rect x="4" y="3" width="8" height="2" fill="#C0392B"/>
                        <rect x="6" y="4" width="4" height="2" fill="#F4C896"/>
                        <rect x="6" y="5" width="1" height="1" fill="#2D2418"/>
                        <rect x="9" y="5" width="1" height="1" fill="#2D2418"/>
                        <rect x="5" y="6" width="6" height="5" fill="#9B59B6"/>
                        <rect x="4" y="7" width="1" height="3" fill="#F4C896"/>
                        <rect x="11" y="7" width="1" height="3" fill="#F4C896"/>
